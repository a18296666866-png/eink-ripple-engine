# 1. 编译生成的构建目录 (体积巨大)
build/
.gradle/
.cxx/
.kotlin/
out/

# 2. 本地环境配置 (包含绝对路径，别人拉下来也跑不了)
local.properties
gradle.properties
.gradle-wrapper.jar # 如果有的话
gradle-wrapper.properties # 如果你改过里面的镜像

# 3. 签名文件 (极其重要，千万不能传)
*.jks
*.keystore
signing.gradle
*.apk
*.aab

# 4. IDE 配置文件
.idea/
*.iml
.vscode/

# 5. 系统临时文件
.DS_Store
Thumbs.db
*.log
*.hprof

# 6. 之前咱们在服务器上生成的临时测试脚本和压缩包
*.zip
*.7z
start.sh
test.sh
